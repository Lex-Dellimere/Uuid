// hashes: MD5 (RFC 1321) and SHA-1 (FIPS 180-4), only for name-based UUIDs.
//
// Versions 3 and 5 are defined on these two hashes, so uuid carries small,
// plain copies of them and needs no other package. Neither hash is safe for
// anything secret: use a real crypto library (cryptex) for that.

import "std/core";

export struct UuidHashState {
  h: uint32[5];
  buf: uint8[64];
  used: int64;
  total: uint64;
  sha1: bool;
}

fn uh_rotl(x: uint32, n: uint32) -> uint32 {
  return (x << n) | (x >> ((uint32)32 - n));
}

fn uh_le32(p: uint8*, i: int64) -> uint32 {
  return (uint32)p[i] | ((uint32)p[i + 1] << (uint32)8) | ((uint32)p[i + 2] << (uint32)16) | ((uint32)p[i + 3] << (uint32)24);
}

fn uh_be32(p: uint8*, i: int64) -> uint32 {
  return ((uint32)p[i] << (uint32)24) | ((uint32)p[i + 1] << (uint32)16) | ((uint32)p[i + 2] << (uint32)8) | (uint32)p[i + 3];
}

// MD5 per-round constants: floor(abs(sin(i + 1)) * 2^32).
const UH_MD5_K: uint32[64] = [
  0xd76aa478, 0xe8c7b756, 0x242070db, 0xc1bdceee, 0xf57c0faf, 0x4787c62a, 0xa8304613, 0xfd469501,
  0x698098d8, 0x8b44f7af, 0xffff5bb1, 0x895cd7be, 0x6b901122, 0xfd987193, 0xa679438e, 0x49b40821,
  0xf61e2562, 0xc040b340, 0x265e5a51, 0xe9b6c7aa, 0xd62f105d, 0x02441453, 0xd8a1e681, 0xe7d3fbc8,
  0x21e1cde6, 0xc33707d6, 0xf4d50d87, 0x455a14ed, 0xa9e3e905, 0xfcefa3f8, 0x676f02d9, 0x8d2a4c8a,
  0xfffa3942, 0x8771f681, 0x6d9d6122, 0xfde5380c, 0xa4beea44, 0x4bdecfa9, 0xf6bb4b60, 0xbebfbc70,
  0x289b7ec6, 0xeaa127fa, 0xd4ef3085, 0x04881d05, 0xd9d4d039, 0xe6db99e5, 0x1fa27cf8, 0xc4ac5665,
  0xf4292244, 0x432aff97, 0xab9423a7, 0xfc93a039, 0x655b59c3, 0x8f0ccc92, 0xffeff47d, 0x85845dd1,
  0x6fa87e4f, 0xfe2ce6e0, 0xa3014314, 0x4e0811a1, 0xf7537e82, 0xbd3af235, 0x2ad7d2bb, 0xeb86d391
];

const UH_MD5_S: uint32[16] = [7, 12, 17, 22, 5, 9, 14, 20, 4, 11, 16, 23, 6, 10, 15, 21];

fn uh_md5_block(s: UuidHashState*, p: uint8*) {
  var m: uint32[16];
  for i in 0..16 { m[i] = uh_le32(p, (int64)i * 4); }
  var a: uint32 = s->h[0];
  var b: uint32 = s->h[1];
  var c: uint32 = s->h[2];
  var d: uint32 = s->h[3];
  for i in 0..64 {
    var f: uint32 = 0;
    var g: int64 = 0;
    var r: int64 = (int64)i / 16;
    if (r == 0) {
      f = (b & c) | (~b & d);
      g = (int64)i;
    } else if (r == 1) {
      f = (d & b) | (~d & c);
      g = (5 * (int64)i + 1) % 16;
    } else if (r == 2) {
      f = b ^ c ^ d;
      g = (3 * (int64)i + 5) % 16;
    } else {
      f = c ^ (b | ~d);
      g = (7 * (int64)i) % 16;
    }
    var t: uint32 = d;
    d = c;
    c = b;
    b = b + uh_rotl(a + f + UH_MD5_K[i] + m[g], UH_MD5_S[r * 4 + (int64)i % 4]);
    a = t;
  }
  s->h[0] = s->h[0] + a;
  s->h[1] = s->h[1] + b;
  s->h[2] = s->h[2] + c;
  s->h[3] = s->h[3] + d;
}

fn uh_sha1_block(s: UuidHashState*, p: uint8*) {
  var w: uint32[80];
  for i in 0..16 { w[i] = uh_be32(p, (int64)i * 4); }
  for i in 16..80 { w[i] = uh_rotl(w[i - 3] ^ w[i - 8] ^ w[i - 14] ^ w[i - 16], 1); }
  var a: uint32 = s->h[0];
  var b: uint32 = s->h[1];
  var c: uint32 = s->h[2];
  var d: uint32 = s->h[3];
  var e: uint32 = s->h[4];
  for i in 0..80 {
    var f: uint32 = 0;
    var k: uint32 = 0;
    if (i < 20) {
      f = (b & c) | (~b & d);
      k = 0x5a827999;
    } else if (i < 40) {
      f = b ^ c ^ d;
      k = 0x6ed9eba1;
    } else if (i < 60) {
      f = (b & c) | (b & d) | (c & d);
      k = 0x8f1bbcdc;
    } else {
      f = b ^ c ^ d;
      k = 0xca62c1d6;
    }
    var t: uint32 = uh_rotl(a, 5) + f + e + k + w[i];
    e = d;
    d = c;
    c = uh_rotl(b, 30);
    b = a;
    a = t;
  }
  s->h[0] = s->h[0] + a;
  s->h[1] = s->h[1] + b;
  s->h[2] = s->h[2] + c;
  s->h[3] = s->h[3] + d;
  s->h[4] = s->h[4] + e;
}

fn uh_block(s: UuidHashState*, p: uint8*) {
  if (s->sha1) {
    uh_sha1_block(s, p);
  } else {
    uh_md5_block(s, p);
  }
}

// Starts a hash: SHA-1 when sha1 is set, else MD5.
export fn uuid_hash_init(s: UuidHashState*, sha1: bool) {
  s->h[0] = 0x67452301;
  s->h[1] = 0xefcdab89;
  s->h[2] = 0x98badcfe;
  s->h[3] = 0x10325476;
  s->h[4] = 0xc3d2e1f0;
  s->used = 0;
  s->total = 0;
  s->sha1 = sha1;
}

export fn uuid_hash_update(s: UuidHashState*, p: uint8*, n: int64) {
  var i: int64 = 0;
  s->total = s->total + (uint64)n;
  if (s->used > 0) {
    while (i < n && s->used < 64) {
      s->buf[s->used] = p[i];
      s->used = s->used + 1;
      i = i + 1;
    }
    if (s->used < 64) { return; }
    uh_block(s, &s->buf[0]);
    s->used = 0;
  }
  while (n - i >= 64) {
    uh_block(s, p + i);
    i = i + 64;
  }
  while (i < n) {
    s->buf[s->used] = p[i];
    s->used = s->used + 1;
    i = i + 1;
  }
}

// Finishes the hash into out: 16 bytes for MD5, 20 for SHA-1.
export fn uuid_hash_final(s: UuidHashState*, out: uint8*) {
  var bits: uint64 = s->total * (uint64)8;
  var pad: uint8[72];
  for i in 0..72 { pad[i] = 0; }
  pad[0] = 0x80;
  var padn: int64 = 56 - s->used;
  if (padn <= 0) { padn = padn + 64; }
  for i in 0..8 {
    if (s->sha1) {
      pad[padn + (int64)i] = (uint8)(bits >> (uint64)(56 - 8 * i));
    } else {
      pad[padn + (int64)i] = (uint8)(bits >> (uint64)(8 * i));
    }
  }
  var keep: uint64 = s->total;
  uuid_hash_update(s, &pad[0], padn + 8);
  s->total = keep;
  if (s->sha1) {
    for i in 0..5 {
      out[i * 4] = (uint8)(s->h[i] >> (uint32)24);
      out[i * 4 + 1] = (uint8)(s->h[i] >> (uint32)16);
      out[i * 4 + 2] = (uint8)(s->h[i] >> (uint32)8);
      out[i * 4 + 3] = (uint8)s->h[i];
    }
  } else {
    for i in 0..4 {
      out[i * 4] = (uint8)s->h[i];
      out[i * 4 + 1] = (uint8)(s->h[i] >> (uint32)8);
      out[i * 4 + 2] = (uint8)(s->h[i] >> (uint32)16);
      out[i * 4 + 3] = (uint8)(s->h[i] >> (uint32)24);
    }
  }
}
